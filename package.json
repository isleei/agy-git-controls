{
  "name": "agy-git-controls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source Git management panel plugin for Google Antigravity (AGY)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate": "agy plugin validate ./dist-plugin --strict",
    "install-plugin": "node scripts/install.mjs",
    "release": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0",
    "zod": "^4.6.7"
  }
}
